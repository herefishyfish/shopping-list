<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Application theme -->
    <style name="AppThemeBase29" parent="AppThemeBase21">

        <!-- 
            Disable forced dark mode on newer devices. 
            Enabling this will make your app appear in dark-mode, 
            but the way the app is converted may lead to visual issues 
        -->
        <item name="android:forceDarkAllowed">false</item>

        <!-- Status bar sits on the ActionBar green → light icons; the navigation bar sits on
             the page background → dark icons in light mode, light icons in dark mode. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">@bool/light_nav_bar</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme" parent="AppThemeBase29">
    </style>

</resources>